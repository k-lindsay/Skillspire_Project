            nn.Conv2d(in_channels=hiddenwork, out_channels=hiddenwork, kernel_size=3, stride=1, padding=1),
            nn.ReLU(),
            nn.Conv2d(in_channels=hiddenwork, out_channels=hiddenwork, kernel_size=3, stride=1, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )
# Classifier...
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(in_features=hiddenwork * 7 * 7, out_features=output)
        )
