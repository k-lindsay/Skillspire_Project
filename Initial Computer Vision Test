import torch
from torch import nn
# Note: Ran into a lot of errors from indentation...
class MNIST_model_example(torch.nn.Module):
    def __init__(self, input: int, hiddenwork: int, output: int):
        super().__init__()
# Block 1
        self.conv_block_1 = nn.Sequential(
            nn.Conv2d(in_channels=input, out_channels=hiddenwork, kernel_size=3, stride=1, padding=1),
            nn.ReLU(),
            nn.Conv2d(in_channels=hiddenwork, out_channels=hiddenwork, kernel_size=3, stride=1, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )
# Block 2...
        self.conv_block_2 = nn.Sequential(
            nn.Conv2d(in_channels=hiddenwork, out_channels=hiddenwork, kernel_size=3, stride=1, padding=1),
            nn.ReLU(),
            nn.Conv2d(in_channels=hiddenwork, out_channels=hiddenwork, kernel_size=3, stride=1, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2)
        )
# Classifier...
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(in_features=hiddenwork * 7 * 7, out_features=output)
        )
# Forward...
    def forward(self, x):
        x = self.conv_block_1(x)
        x = self.conv_block_2(x)
        x = self.classifier(x)
        return x

